+/// RECORD: every default seed's history with its witness, to the file `MANTLE_RECORD` names.
+#[test]
+#[ignore]
+fn record_histories() {
+    let mut out = String::new();
+    for seed in 1..=48u64 {
+        let members = if seed % 2 == 0 { 5 } else { 3 };
+        let ran = run(seed, members);
+        out.push_str(&format!("s {seed}\n"));
+        for line in ran.record {
+            out.push_str(&line);
+            out.push('\n');
+        }
+    }
+    std::fs::write(std::env::var("MANTLE_RECORD").unwrap(), out).unwrap();
+}
